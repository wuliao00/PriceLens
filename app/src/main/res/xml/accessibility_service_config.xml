    android:notificationTimeout="300"
    android:packageNames="com.jingdong.app.mall,com.taobao.taobao,com.xunmeng.pinduoduo"
    android:description="@string/accessibility_desc"
    android:isAccessibilityTool="true"
    android:settingsActivity="com.pricelens.ui.main.MainActivity" />
