<?xml version="1.0" encoding="utf-8"?>
<!--
  A2 比价浮窗 / 状态口径新增文案（独立文件，避免与 strings.xml 合并冲突）。
  命名统一 ovl_ 前缀；overlay_cta / overview_live_price 等旧 key 仍在 strings.xml。
-->
<resources>

    <!-- 价格口径标签（浮窗第①行，裸数字绝不冒充到手价） -->
    <string name="ovl_basis_page">页面价</string>
    <string name="ovl_basis_coupon">券后价</string>
    <string name="ovl_basis_net">到手价</string>

    <!-- 内容描述 -->
    <string name="ovl_cd_close">关闭浮窗</string>

    <!-- PL-29 浮窗收起为小圆球（不加设置开关：胶囊条上常驻「收起」入口） -->
    <string name="ovl_ball_collapse">收起</string>
    <!-- 价格读不出来时球上的兜底字（ballLabel 是纯函数，只出价与 ↑/↓ 百分数，不产词） -->
    <string name="ovl_ball_no_price">比价</string>
    <string name="ovl_ball_cd_expand">价格浮窗小圆球，点击展开 · %1$s</string>

    <!-- 浮窗行文案 -->
    <string name="ovl_title_fallback">当前商品</string>
    <!-- 历史最低行：窗口内有曲线点才允许说"90 天最低"；窗口内无点时只能明说是窗口外的老曲线（F3 缺陷一） -->
    <string name="ovl_history_high">90 天最低 %1$s · 当前高 %2$d%%</string>
    <string name="ovl_history_near_low">90 天最低 %1$s · 当前接近历史低价</string>
    <string name="ovl_history_high_older">历史最低 %1$s（90 天窗口外） · 当前高 %2$d%%</string>
    <string name="ovl_history_near_low_older">历史最低 %1$s（90 天窗口外） · 当前已到该价位或更低</string>
    <string name="ovl_platforms_note">不同店铺/规格，仅供参考</string>
    <string name="ovl_coupon_chip">%1$d 元券 · %2$s</string>
    <string name="ovl_coupon_threshold">满 %1$d</string>
    <string name="ovl_coupon_no_threshold">无门槛</string>
    <string name="ovl_footer_bundle">来源 %1$s · %2$s · 非实时</string>
    <!-- 数据抓取时刻不可知：宁可不说时间，也不能拿打包时刻冒充"刚刚"（F3 缺陷二） -->
    <string name="ovl_footer_bundle_no_time">来源 %1$s · 数据抓取时间未知 · 非实时</string>
    <string name="ovl_footer_live">来源 %1$s · 实时读取</string>
    <string name="ovl_bundle_stale">缓存降级 · 可能不是最新</string>
    <string name="ovl_title_only_cta">识别到标题 · 点击在 App 内搜索</string>
    <string name="ovl_title_only_hint">仅识别到标题 · 不显示历史价/多平台比价</string>

    <!-- 概览页"上一次商品数据"提示（待 OverviewScreen 绑定时消费） -->
    <string name="ovl_overview_stale">当前结果为上一次商品数据（本次关键词未命中同款候选）</string>

    <!-- 识别来源（无障碍读取） -->
    <string name="ovl_source_jd">本机京东账号</string>
    <string name="ovl_source_taobao">本机淘宝账号</string>
    <string name="ovl_source_pdd">本机拼多多账号</string>
    <string name="ovl_source_unknown">本机电商账号</string>

    <!-- 平台胶囊名 -->
    <string name="ovl_platform_jd">京东</string>
    <string name="ovl_platform_taobao">淘宝</string>
    <string name="ovl_platform_pdd">拼多多</string>


    <!-- 免凭证曲线：浮窗身份确认闸门（用户拍板的唯一免凭证攒点通道） -->
    <string name="ovl_confirm_cta">就是这个商品 · 开始记录本机价</string>
    <!-- M7：已确认行把本机曲线真的读回来（天数 + 本机最低）；最低价由 PriceFormatter 格式化好传入 -->
    <string name="ovl_confirmed_line">已确认身份 · 已记 %1$d 天 · 本机最低 %2$s</string>
    <!-- 一个可用日点都没有（刚确认、今日还不够格写点）：只说天数，绝不拿 0 冒充最低价 -->
    <string name="ovl_confirmed_line_days">已确认身份 · 已记 %1$d 天 · 之后每次读到页面价都会记成当天一点</string>
    <string name="ovl_confirmed_cancel">取消确认</string>
    <string name="ovl_confirm_full_toast">已确认的身份太多（上限 %1$d 个），先到盯价页清理一个</string>
    <!-- M6：确认被拒不再静默——没标题或平台认不出来时连身份键都构不出来，必须说给用户听 -->
    <string name="ovl_confirm_noteligible_toast">商品信息不足，无法确认身份</string>

    <!-- 盯价页身份管理区（浮窗确认的入口在浮窗，管理/取消在这一节） -->
    <string name="watch_identity_section_title">浮窗确认的本机身份</string>
    <string name="watch_identity_days">已记录 %1$d 天 · 只记页面价，随本机浏览增长</string>
    <string name="watch_identity_cancel">取消并删除记录</string>
</resources>
