<?xml version="1.0" encoding="utf-8"?>
<!--
  端侧识别（可选）的文案。三条纪律：
  1. 不许出现"已核验/已确认"这类词（本版没有核验层，CouponStringsGuardTest 扫的是 strings_coupon.xml，
     这份文件同样不写 —— 文字上不给自己留把柄）；
  2. 推荐要**带依据**：几核、多少内存、电量都摆出来，用户看不到依据的"推荐"就是推销；
  3. 失败要说清是哪一步（没下完 / 下完但校验不过），不许只说"失败了"。
-->
<resources>
    <string name="ai_model_title">端侧识别（可选）</string>
    <string name="ai_model_device_summary">本机：%1$d 核 · 内存 %2$d GB（可用 %3$d GB）· 电量 %4$d%%</string>
    <string name="ai_model_recommend">这台手机可以跑端侧识别。模型（%1$d MB）从项目仓库下载，不进安装包、不占缓存那 30MB 预算。</string>
    <string name="ai_model_download">下载模型</string>
    <string name="ai_model_delete">删除模型</string>
    <string name="ai_model_ready">端侧识别已启用（找券低置信时会用它兜底）</string>
