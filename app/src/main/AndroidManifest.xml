<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 无障碍浮窗（§1.5）：检测到价格后在京东/淘宝/拼多多页面之上显示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 后台自启动：开机后恢复盯价与缓存清理任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：仅能看到电商 APP（§1.6 最小权限） -->
    <queries>
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.xunmeng.pinduoduo" />
        <!-- Shizuku（设置页检测“已安装未启动”状态需要包可见性） -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- 网络安全：全部比价 API 域名均为 HTTPS（Shihuo 图片 http 链接已在 ShihuoApi 内改写为 https），
         维持默认禁止明文流量，不启用 usesCleartextTraffic，无需 network_security_config -->
    <application
        android:name=".PriceLensApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PriceLens">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 无障碍服务（§1.3）：仅监听电商 APP，BIND_ACCESSIBILITY_SERVICE 系统级保护 -->
        <service
            android:name=".accessibility.PriceMonitorService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机自启动：重新登记 WorkManager 周期任务（盯价 + 缓存清理） -->
        <receiver
            android:name=".worker.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 使用 Hilt 自定义 WorkManager 配置，禁用默认初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Shizuku：免 root 授权执行开启无障碍的 shell 命令。
             注意：不要给 provider 加 android:permission="android.permission.DIALOG"，
             DIALOG 是签名级权限，会导致 Shizuku 服务（shell uid）无法向本应用推送 binder，
             表现为"已授权/服务已启动，但应用内一直显示服务未启动" -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true" />
    </application>
</manifest>
