{
  "schemaVersion": 1,
  "id": "jd",
  "version": 3,
  "description": "京东 App 商详页选择器（现货 / 预约 / 国补三种底栏文案都覆盖）。gate 是商详门控词表的远端可改副本，必须与出厂 PageVocabulary.DEFAULT 逐项相等（BuiltinRuleTest 比对钉死），改词表 = 推规则，不用发 APK。规则说明见 docs/API.md「选择器规则远程订阅」。",
  "packages": [
    "com.jingdong"
  ],
  "pages": [
    {
      "name": "product_detail",
      "activityRegex": ".*ProductDetail.*",
      "extract": {
        "title": [
          {
            "by": "viewId",
            "value": "com.jingdong.app.mall:id/pd_title"
          },
          {
            "by": "descRegex",
            "value": "商品名称[：:]\\s*(.+)",
            "group": 1
          },
          {
            "by": "textRegex",
            "value": "^[^¥￥]{10,80}$"
          }
        ],
        "price": [
          {
            "by": "viewId",
            "value": "com.jingdong.app.mall:id/pd_price"
          },
          {
            "by": "textRegex",
            "value": "[¥￥]\\s*\\d[\\d,]*(?:\\.\\d{1,2})?"
          }
        ],
        "buyNow": [
          {
            "by": "textRegex",
            "value": "立即购买|领券购买|现在购买|马上抢|立即预约|单独购买|领取补贴购买"
          }
        ],
        "checkout": [
          {
            "by": "textRegex",
            "value": "去结算|提交订单|立即支付|合计"
          }
        ]
      },
      "confirm": {
        "allOf": [
          "title",
          "price",
          "buyNow"
        ],
        "noneOf": [
          "checkout"
        ]
      }
    }
  ],
  "gate": {
    "buyAction": [
      "加入购物车",
      "立即购买",
      "领券购买",
      "马上抢",
      "现在购买",
      "单独购买",
      "立即预约"
    ],
    "buyNow": [
      "立即购买",
      "领券购买",
      "马上抢",
      "现在购买",
      "单独购买",
      "立即预约",
      "领取补贴购买"
    ],
    "detailSection": [
      "商品详情",
      "宝贝详情",
      "图文详情",
      "商品评价",
      "宝贝评价"
    ],
    "checkout": [
      "去结算",
      "提交订单",
      "立即支付",
      "合计"
    ],
    "pddSingleBuy": [
      "单独购买"
    ],
    "pddGroupBuy": [
      "发起拼单",
      "立即拼单"
    ]
  }
}
